# ไฟล์เฉพาะเครื่อง / ความลับ
.env
.env.*
!.env.example
.claude/
.DS_Store

# Frontend (ดู frontend/.gitignore เพิ่มเติม)
node_modules/
dist/

# Backend (Flask)
Backend/.env
Backend/instance/*
!Backend/instance/.gitkeep
__pycache__/
*.pyc
.venv/
venv/

# ใบรับรอง/กุญแจ (ห้ามอัปโหลด)
*.pem
*.key

# Local database upgrade backups
Backend/.db-backups/
backups/

# Local QA evidence and operational reports (may contain workstation/store data)
Backend/qa/artifacts/
Backend/qa/*-20??-??-??.md
