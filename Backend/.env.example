# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env และห้ามใส่ความลับในไฟล์ .env.example นี้)
# กฎ: หนึ่งบรรทัด = หนึ่งตัวแปร เขียนค่าบรรทัดเดียว ห้ามมีคอมเมนต์ต่อท้ายบรรทัดเดียวกัน และอย่าใส่ตัวแปรซ้ำ

# ฐานข้อมูล: เว้นว่าง = ใช้ SQLite ในเครื่อง (instance/dev.db) สำหรับทดลอง
# MySQL ออนไลน์: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE   (อักขระพิเศษในรหัสผ่านต้องแปลง: @ = %40, / = %2F, # = %23)
DATABASE_URL=

# ถ้าฐานข้อมูลบังคับ SSL (เช่น Aiven): path ของไฟล์ CA certificate (.pem) ใช้ / ไม่ใช้ \
DB_SSL_CA=

# ข้อความสุ่มยาว ๆ ของระบบ (เปลี่ยนก่อนใช้งานจริง)
SECRET_KEY=change-me

# หน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย ,)
CORS_ORIGINS=http://localhost:5173

# AI (Groq): ขอคีย์ที่ https://console.groq.com/keys — ใส่ในไฟล์ .env เท่านั้น
GROQ_API_KEY=

# โมเดลของ Groq (เว้นว่าง = openai/gpt-oss-120b) ดูรายชื่อที่ https://console.groq.com/docs/models
GROQ_MODEL=

# อีเมล (SMTP) สำหรับส่ง OTP ลืมรหัสผ่าน — เว้นว่าง SMTP_HOST = ยังไม่ส่งอีเมลจริง (โหมดทดลอง)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=อีเมลคุณ, SMTP_PASSWORD=รหัสผ่านแอป 16 ตัว (ไม่ต้องใส่เครื่องหมายคำพูด) (สร้างที่ https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ตอน deploy จริงให้ตั้งเป็น production (ห้ามตอบ OTP กลับในคำตอบ — ต้องตั้งค่าอีเมลก่อน — และปิดคำสั่ง reset-db)
# APP_ENV=production
